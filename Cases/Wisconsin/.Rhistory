tbl <- table(dtree.pred, validation$Class,
dnn=c("Predicted", "Actual"))
confusionMatrix(tbl,positive = "Malignant")
library(pROC)
plot.roc(validation$Class, dtree.pred.prob[,2], print.auc=TRUE ,
col="red", main="RPART",legacy.axes=TRUE)
