Sonar <- read.csv("Sonar.csv", stringsAsFactors = T)
library(caret)
set.seed(26)
intrain<-createDataPartition(y = Sonar$Class,p=0.7,list=FALSE)
training   <- Sonar[ intrain , ]
validation <- Sonar[-intrain , ]
library(rpart)
model.rp <- rpart(Class ~ . , data = training, method = "class")
pred.rp <- predict(model.rp, newdata = validation, type = "class")
confusionMatrix(pred.rp, validation$Class, dnn=c("Predicted", "Actual"))
library(ada)
model.ada <- ada(Class ~ . , data = training)
pred.ada <- predict(model.ada, newdata = validation, type = "vector")
confusionMatrix(pred.ada, validation$Class,
dnn=c("Predicted", "Actual"))
output_train <- addtest(x=model.ada , test.x = validation[,-61],
test.y = validation$Class)
plot(output_train, test = T)
varplot(output_train)
plot(output_train, test = T)
